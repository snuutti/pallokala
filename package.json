{
    "name": "pallokala",
    "main": "expo-router/entry",
    "version": "1.8.0",
    "scripts": {
        "postinstall": "bun ./scripts/patchPackages.cjs && bun run plugin:build",
        "start": "expo start",
        "android": "APP_VARIANT=development expo run:android",
        "ios": "APP_VARIANT=development expo run:ios",
        "test": "jest --watchAll",
        "lint": "expo lint",
        "check-types": "tsc --noEmit",
        "plugin:build": "tsc -p ./plugin/tsconfig.json",
        "build-aab": "mkdir -p ~/eas-temp-workdir && TMPDIR=~/eas-temp-workdir eas build --local --non-interactive --platform android --profile production && rm -rf ~/eas-temp-workdir"
    },
    "jest": {
        "preset": "jest-expo"
    },
    "expo": {
        "doctor": {
            "reactNativeDirectoryCheck": {
                "exclude": ["@dylankenneally/react-native-ssh-sftp"],
                "listUnknownPackages": false
            }
        }
    },
    "dependencies": {
        "@dylankenneally/react-native-ssh-sftp": "^1.7.0",
